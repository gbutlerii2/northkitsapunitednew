---
interface Props {
  question: string;
  number: number;
}

const { question, number } = Astro.props;
---

<details class="group border-b border-gray-200">
  <summary class="flex items-start gap-3 cursor-pointer py-4 text-left hover:bg-gray-50 px-2 rounded-md transition-colors">
    <span class="text-nku-green font-bold text-sm mt-0.5 shrink-0">{number}.</span>
    <span class="font-semibold text-nku-gray group-open:text-nku-green transition-colors">{question}</span>
    <svg
      class="w-5 h-5 shrink-0 text-nku-gray-light ml-auto mt-0.5 transition-transform group-open:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>
  <div class="pb-4 pl-8 pr-2 text-nku-gray leading-relaxed">
    <slot />
  </div>
</details>
