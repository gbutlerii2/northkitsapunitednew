---
// Newsletter signup with Google Forms
---

<section class="bg-nku-cream py-12 relative overflow-hidden">
  <img src="/images/transition-top.png" alt="" class="absolute top-0 left-0 w-full z-20 pointer-events-none" />
  <div class="absolute inset-0 opacity-100" style="background-image: url('/images/Topo_Repeat_Get_Involved.png'); background-repeat: repeat; background-size: 800px;"></div>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-2xl font-bold text-nku-green mb-3">Stay Updated</h2>
    <p class="text-nku-gray mb-6">
      Sign up for our newsletter to receive project updates and meeting announcements.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLScsNZr4Spd9GR1KOQsO4bF_c7yytyFxwSQbeYSx4VhqVII33w/viewform"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-nku-green text-white font-semibold px-8 py-3 rounded-lg hover:bg-nku-green-light transition-colors"
      >
        Subscribe to Newsletter
      </a>
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSfd_GxnRxclWtmPr4FYr4sMGVOiw72A-q7oPIYA5S4ftBhx6Q/viewform"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-nku-gray font-semibold px-8 py-3 rounded-lg border border-gray-300 hover:border-nku-green hover:text-nku-green transition-colors"
      >
        Unsubscribe
      </a>
    </div>
  </div>
</section>
