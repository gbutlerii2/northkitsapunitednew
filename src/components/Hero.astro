---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-nku-green py-16 sm:py-20 relative overflow-hidden">
  <div class="absolute inset-0 opacity-60" style="background-image: url('/images/Topo_Repeat_Header.png'); background-repeat: repeat; background-size: 800px;"></div>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
      {title}
    </h1>
    {subtitle && (
      <p class="text-lg sm:text-xl text-green-100 max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}
  </div>
  <img src="/images/transition-bottom.png" alt="" class="absolute bottom-0 left-0 w-full z-20 pointer-events-none" />
</section>
