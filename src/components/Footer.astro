---
const currentYear = new Date().getFullYear();
const footerLinks = [
  { label: 'Privacy Statement', href: '/privacy-statement' },
  { label: 'Terms of Use', href: '/terms-of-use' },
  { label: 'Accessibility', href: '/accessibility' },
];
---
<footer class="footer">
  <div class="footer-inner">
    <nav class="footer-links" aria-label="Footer navigation">
      {footerLinks.map((link) => <a class="footer-link" href={link.href}>{link.label}</a>)}
    </nav>
    <p style="margin:0">&copy; {currentYear} Rotary Club of Kingston North Kitsap, for North Kitsap United. All rights reserved.</p>
    <p class="footer-fine" style="margin:0">
      North Kitsap United is a community project website operated by the Rotary Club of Kingston North Kitsap.
      Raydient Places + Properties is a landowner and project supporter, but does not operate this website or manage website submissions.
    </p>
  </div>
</footer>
