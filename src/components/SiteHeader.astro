---
// Site header: one banner image (editable in the admin panel, shared by every page)
// and the main menu: Home, About (History, Materials, FAQ, News), Partners, Get Involved,
// Contact, then Donate as a button on the right (Round 2 sheet, Nov 16 2026).
import EditableRegion from './EditableRegion.astro';
interface Props { current?: string }
const { current = '' } = Astro.props;
const on = (keys: string[]) => (keys.includes(current) ? 'page' : undefined);
---
<header class="site-head">
  <EditableRegion id="header" path="/_site">
    <div class="head-inner head-banner">
      <a class="site-banner" href="/"><img class="site-banner-img" src="/images/site/header-banner.jpg" alt="North Kitsap United. NKU is a project of YMCA of Pierce and Kitsap Counties, and Kingston North Kitsap Rotary Club." width="1087" height="221"></a>
    </div>
  </EditableRegion>
  <nav class="nav" aria-label="Main menu">
    <div class="nav-inner">
      <a class="nav-link" href="/" aria-current={on(['home'])}>Home</a>
      <div class="nav-item">
        <a class="nav-link" href="/history" aria-current={on(['history', 'materials', 'faq', 'news'])}>About <span class="nav-caret" aria-hidden="true">▾</span></a>
        <div class="nav-sub">
          <a class="nav-sub-link" href="/history">History</a>
          <a class="nav-sub-link" href="/materials">Materials</a>
          <a class="nav-sub-link" href="/faq">FAQ</a>
          <a class="nav-sub-link" href="/news">News</a>
        </div>
      </div>
      <div class="nav-item nav-partners">
        <a class="nav-link" href="/partners" aria-current={on(['partners', 'rotary', 'ymca'])}>Partners <span class="nav-caret" aria-hidden="true">▾</span></a>
        <div class="nav-sub">
          <a class="nav-sub-link" href="/planning-team/kingston-north-kitsap-rotary-club">Kingston North Kitsap Rotary Club</a>
          <a class="nav-sub-link" href="/planning-team/ymca-of-pierce-and-kitsap-counties">YMCA of Pierce and Kitsap Counties</a>
          <a class="nav-sub-link" href="/partners">Additional Partners and Supporters</a>
        </div>
      </div>
      <a class="nav-link" href="/get-involved" aria-current={on(['involved'])}>Get Involved</a>
      <a class="nav-link" href="/contact-us" aria-current={on(['contact'])}>Contact</a>
      <a class="nav-link nav-donate" href="/donate" aria-current={on(['cash', 'inkind'])}>Donate</a>
    </div>
  </nav>
</header>
