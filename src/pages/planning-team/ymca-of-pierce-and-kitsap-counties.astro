---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<BaseLayout title="YMCA of Pierce and Kitsap Counties" description="Learn about the YMCA's role in the North Kitsap United project and their community impact.">
  <Hero title="YMCA of Pierce and Kitsap Counties" subtitle="Strengthening community through health and wellness" />

  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- YMCA Logo -->
      <div class="text-center mb-8">
        <img src="/images/logos/ymca-logo.png" alt="YMCA of Pierce and Kitsap Counties logo" class="w-50 h-50 mx-auto object-contain" />
      </div>

      <div class="prose">
        <p>
          The Y is the leading nonprofit committed to strengthening community by connecting all people to
          their potential, purpose, and each other.
        </p>
        <p>
          The organization works locally to empower young people, improve health and well-being, and inspire
          community action by bringing together diverse groups.
        </p>

        <h2>North Kitsap Presence</h2>
        <p>
          More than 3,300 households in North Kitsap are currently YMCA members. A new community center
          would expand service capacity and reduce commute times for existing members.
        </p>

        <h2>Community Impact</h2>
        <ul>
          <li>$2.5 million in financial assistance to 11,000+ members</li>
          <li>1,312 kids in foster care received free memberships</li>
          <li>1 of 5 campers (overnight and day camp) received financial assistance</li>
          <li>1 of 3 kids in Before- and After-School Care received financial assistance</li>
          <li>165 members in Poulsbo already receive financial assistance today</li>
        </ul>

        <h2>Programs Beyond Fitness</h2>
        <p>
          <strong>Late Nite</strong> provides free evening programs for teens.
          <strong>Safety Around Water</strong> offers free drowning prevention education to 600 kids.
          <strong>LIVESTRONG</strong> is a 12-week physical activity program showing a 33.3% decrease in perceived pain.
          The organization also operates a <strong>Shower Access Program</strong> for neighbors in need.
        </p>

        <h2>Market Interest</h2>
        <p>
          A 2016 market report indicated 66% of North Kitsap respondents were very likely to use a YMCA facility.
        </p>
      </div>

      <!-- YMCA Images -->
      <div class="mt-12 space-y-6">
        <img src="/images/ymca-1.png" alt="YMCA facility rendering" class="rounded-lg w-full" loading="lazy" />
        <img src="/images/ymca-2.png" alt="YMCA facility rendering" class="rounded-lg w-full" loading="lazy" />
        <img src="/images/ymca-3.png" alt="YMCA facility rendering" class="rounded-lg w-full" loading="lazy" />
      </div>

      <!-- Cross-links -->
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h3 class="font-semibold text-nku-gray mb-4">Our Partners</h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/planning-team/kingston-north-kitsap-rotary-club" class="flex-1 p-4 rounded-lg border border-gray-200 hover:border-nku-green hover:shadow-md transition-all text-center">
            <span class="font-medium text-nku-gray">Kingston-North Kitsap Rotary Club</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
