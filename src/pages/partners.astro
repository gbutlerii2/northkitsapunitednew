---
// Generated from the NKU Website design (build/pages.py). Edit the content there and regenerate.
import BaseLayout from '../layouts/BaseLayout.astro';
const html = `<section class="grid3" aria-label="Partners">
  <div class="logo-box"><img src="/images/site/lg5-port-gamble-s-klallam-tribe-logo-partners.png" alt="Port Gamble S’Klallam Tribe logo" class="rounded-lg my-4" style="width:100%;height:auto" /><h2 class="h3">Port Gamble S’Klallam Tribe</h2><a class="link" href="https://pgst.nsn.us/">Visit website →</a></div>
  <div class="logo-box"><img class="logo-img" src="/images/site/wsdga-logo.png" alt="West Sound Disc Golf Association logo" /><h2 class="h3">West Sound Disc Golf Association</h2><a class="link" href="https://www.wsdga.org/">Visit website →</a></div>
</section>
<section class="card">
  <h2 class="h2">Our Supporters</h2>
  <div class="grid4"><div class="logo-box"><img class="logo-img" src="/images/site/cal-ripken-sr-foundation-logo.png" alt="Cal Ripken, Sr. Foundation logo" /><strong>Cal Ripken, Sr. Foundation</strong></div><div class="logo-box"><img src="/images/site/lg6-greater-kingston-kiwanis-logo-partners.webp" alt="Greater Kingston Kiwanis logo" class="rounded-lg my-4" style="width:100%;height:auto" /><strong>Greater Kingston Kiwanis</strong></div><div class="logo-box"><img src="/images/site/lg7-kysa-logo-partners.png" alt="Kingston Youth Sports Association logo" class="rounded-lg my-4" style="width:50%;height:auto;margin-left:auto;margin-right:auto;display:block" /><strong>Kingston Youth Sports Association</strong></div><div class="logo-box"><img src="/images/site/lg8-valley-nursery-logo-partners.webp" alt="Valley Nursery logo" class="rounded-lg my-4" style="width:50%;height:auto;margin-left:auto;margin-right:auto;display:block" /><strong>Valley Nursery</strong></div><div class="logo-box"><img class="logo-img" src="/images/site/lg9-port-of-kingston-logo-partners.png" alt="Port of Kingston logo" /><strong>Port of Kingston</strong></div><div class="logo-box"><img class="logo-img" src="/images/site/kitsap-building-association-logo-partners.jpg" alt="Kitsap Building Association logo" /><strong>Kitsap Building Association</strong></div><div class="logo-box"><img class="logo-img" src="/images/site/kitsap-economic-development-alliance-logo-partners.png" alt="Kitsap Economic Development Alliance logo" /><strong>Kitsap Economic Development Alliance</strong></div><div class="logo-box"><img class="logo-img" src="/images/site/kingston-stakeholders-logo.png" alt="Kingston Stakeholders logo." /><strong>Kingston Stakeholders</strong></div></div>
