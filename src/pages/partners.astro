</section>
<div class="btn-row"><a class="btn btn-gold" href="/donate">Donate</a><a class="btn btn-ghost" href="/get-involved">Get Involved</a></div>

`;
---
<BaseLayout title="Additional Partners and Supporters" current="partners" heroTitle="Additional Partners and Supporters" heroSub="[Introduction to come.]" eyebrow="Partners">
