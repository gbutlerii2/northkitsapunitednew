import Hero from '../../components/Hero.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<BaseLayout title="Context" description="Learn about the Raydient property on SR 307 and its history as part of a corporate tree farm dating back to the 1800s.">
  <Hero title="Context" subtitle="Understanding the property and its history" />

  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose">
        <p>
          The Raydient property is comprised of approximately 400 acres on SR 307 adjacent to the Port Gamble
          Forest Heritage Park.
        </p>
        <p>
          The property was originally part of a corporate tree farm originated in the 1800s that included the
          town of Port Gamble. Most of that holding now comprises the Port Gamble Forest Heritage Park. The next
          timber harvest will be its fourth rotation.
        </p>
        <p>
          In 2007, then-property owner Pope Resources announced that it was on track to sell all of its North
          Kitsap lands. Local conditions&mdash;chiefly suburbanization&mdash;were changing rapidly, and the
          company realized the community would soon be intolerant of commercial timberland management. From 2007
          to 2017 Pope subsidiary Olympic Property Group worked extensively with the community and a host of
          other organizations to raise money and transfer ownership of the property to Kitsap County. This effort
          created the &ldquo;String of Pearls,&rdquo; a vast system of public trails and open spaces.
        </p>
        <p>
          In 2020, Rayonier acquired Pope Resources. Rayonier continues to evaluate the long-term disposition of 
          its North Kitsap holdings in alignment with its strategic goals. All of Raydient's local timberlands were
          subdivided into 20-acre lots more than 15 years ago.
        </p>
      </div>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
