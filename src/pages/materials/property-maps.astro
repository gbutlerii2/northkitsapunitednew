---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import MapCard from '../../components/MapCard.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const maps = [
  {
    title: 'NKU Topography',
    src: '/images/maps/nku-topography.jpg',
    alt: 'Topographic map of the NKU property showing elevation and terrain features',
  },
  {
    title: 'NKU Critical Areas',
    src: '/images/maps/nku-critical-areas.jpg',
    alt: 'Map showing environmentally sensitive zones within the NKU development area',
  },
  {
    title: 'NKU Tree Cover',
    src: '/images/maps/nku-tree-cover-v2.jpg',
    alt: 'Map showing existing forest and vegetation coverage on the NKU property',
  },
  {
    title: 'Vicinity Map',
    src: '/images/maps/nku-vicinity-map-v2.jpg',
    alt: 'Map showing the NKU property location relative to surrounding areas',
  },
  {
    title: 'Trail Easement',
    src: '/images/maps/nku-trail-easement.jpg',
    alt: 'Map showing areas reserved for trail development and public access',
  },
  {
    title: 'Existing Trails',
    src: '/images/maps/nku-existing-trails-v2.jpg',
    alt: 'Map showing current trail systems on or near the NKU property',
  },
  {
    title: 'NKU Activity Map',
    src: '/images/maps/nku-activity-map.png',
    alt: 'North Kitsap United activity map',
  },
  {
    title: 'NKU Landscape Map',
    src: '/images/maps/nku-landscape-map.png',
    alt: 'North Kitsap United landscape map',
  },
];
---

<BaseLayout title="Property Maps" description="View maps of the North Kitsap United property including topography, critical areas, trails, and more.">
  <Hero title="Property Maps" subtitle="Explore the NKU property through detailed maps" />

  <section class="py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {maps.map((map) => (
          <MapCard title={map.title} src={map.src} alt={map.alt} />
        ))}
      </div>
      <p class="text-sm text-nku-gray-light mt-6 text-center">
        Click on any map to view it in full size.
      </p>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
