<section class="card" aria-label="Timeline">
  <div class="timeline"><div class="tl-item"><span class="tl-dot" aria-hidden="true"></span><span class="tl-date">[DATE]</span><h2 class="h3">[Milestone title]</h2><p class="p">[One to three sentences.]</p></div><div class="tl-item"><span class="tl-dot" aria-hidden="true"></span><span class="tl-date">[DATE]</span><h2 class="h3">[Milestone title]</h2><p class="p">[One to three sentences.]</p></div><div class="tl-item"><span class="tl-dot" aria-hidden="true"></span><span class="tl-date">[DATE]</span><h2 class="h3">[Milestone title]</h2><p class="p">[One to three sentences.]</p></div><div class="tl-item"><span class="tl-dot" aria-hidden="true"></span><span class="tl-date">[DATE]</span><h2 class="h3">[Milestone title]</h2><p class="p">[One to three sentences.]</p></div><div class="tl-item"><span class="tl-dot" aria-hidden="true"></span><span class="tl-date">[DATE]</span><h2 class="h3">[Milestone title]</h2><p class="p">[One to three sentences.]</p></div></div>
</section>
-->
<div class="btn-row"><a class="btn btn-gold" href="/donate">Donate</a><a class="btn btn-ghost" href="/get-involved">Get Involved</a></div>
`;
---
<BaseLayout title="History" current="history" heroTitle="How We Got Here" heroSub="[Brief history to come.]" eyebrow="History">
  <Fragment set:html={html} />
</BaseLayout>
