---
// Generated from the NKU Website design (build/pages.py). Edit the content there and regenerate.
import BaseLayout from '../layouts/BaseLayout.astro';
const html = "\n<section class=\"card\">\n  <h2 class=\"h2\">Send us a message</h2>\n  <form class=\"form\" data-nku-form=\"contact\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Name *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label></div><label class=\"field\">Topic<select class=\"input\" name=\"topic\"><option>Join the Team</option><option>How can I help?</option><option>General Project</option></select></label><label class=\"field\">Message *<textarea class=\"textarea\" name=\"message\" rows=\"5\" required></textarea></label><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\">Send</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p></form>\n</section>\n<section class=\"card\">\n  <h2 class=\"h2\">Mail</h2>\n  <address class=\"address\">Kingston North Kitsap Rotary<br>P.O. Box 832, Kingston, WA 98346</address>\n</section>\n<div class=\"btn-row\"><a class=\"btn btn-gold\" href=\"/donate\">Donate</a><a class=\"btn btn-ghost\" href=\"/get-involved\">Get Involved</a></div>\n";
---
<BaseLayout title="Contact Us" current="contact" heroTitle="Contact Us" heroSub="Have a question about North Kitsap United, or want to help? Send us a message and a member of our team will get back to you." eyebrow="Contact">
  <Fragment set:html={html} />
</BaseLayout>
