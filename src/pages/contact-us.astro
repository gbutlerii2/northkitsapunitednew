---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Contact Us" description="Share your questions or comments about the North Kitsap United project.">
  <Hero title="Contact Us" subtitle="We'd love to hear from you" />

  <section class="py-12 sm:py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <p class="text-nku-gray text-lg">
          Have questions or comments about the North Kitsap United collaboration?
          We welcome your feedback and will respond to your inquiry as soon as possible.
        </p>
      </div>

      <div id="form-container" class="rounded-lg overflow-hidden border border-gray-200">
        <iframe
          id="contact-form"
          src="https://docs.google.com/forms/d/e/1FAIpQLSdj8goaEjlJpvUSb4vy56LHd2NRDPoGKcq-5Uw1HTNK_7JAqA/viewform?embedded=true"
          width="100%"
          height="800"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Contact Us Form"
        >Loading…</iframe>
      </div>

      <noscript>
        <div class="mt-6 p-6 bg-nku-cream rounded-lg text-center">
          <p class="text-nku-gray">The contact form requires JavaScript to load. Please reach out to us directly:</p>
          <p class="mt-2">
            <a href="mailto:kingstonsportscomplex@gmail.com" class="text-nku-green font-semibold hover:underline">kingstonsportscomplex@gmail.com</a>
          </p>
        </div>
      </noscript>

      <div id="form-fallback" class="mt-6 p-6 bg-nku-cream rounded-lg text-center hidden">
        <p class="text-nku-gray">The contact form could not be loaded. Please reach out to us directly:</p>
        <p class="mt-2">
          <a href="mailto:kingstonsportscomplex@gmail.com" class="text-nku-green font-semibold hover:underline">kingstonsportscomplex@gmail.com</a>
        </p>
      </div>

      <script>
        const iframe = document.getElementById('contact-form');
        const fallback = document.getElementById('form-fallback');
        let loaded = false;

        if (iframe) {
          iframe.addEventListener('load', () => { loaded = true; });
        }

        setTimeout(() => {
          if (!loaded && fallback) fallback.classList.remove('hidden');
        }, 8000);
      </script>

      <!-- Always-visible direct email option -->
      <div class="mt-8 pt-8 border-t border-gray-200 text-center">
        <p class="text-nku-gray mb-2">Prefer to email us directly?</p>
        <a id="email-link" class="inline-flex items-center gap-2 text-nku-green font-semibold hover:underline cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span id="email-text">Loading…</span>
        </a>
      </div>

      <script>
        // Obfuscate email to reduce spam harvesting
        const user = 'kingstonsportscomplex';
        const domain = 'gmail.com';
        const addr = user + '@' + domain;
        const link = document.getElementById('email-link');
        const text = document.getElementById('email-text');
        if (link) link.setAttribute('href', 'mailto:' + addr);
        if (text) text.textContent = addr;
      </script>
    </div>
  </section>
</BaseLayout>
