---
// Generated from the NKU Website design (build/pages.py). Edit the content there and regenerate.
import BaseLayout from '../layouts/BaseLayout.astro';
const html = `
<div class="btn-row"><a class="btn btn-gold" href="#signup">Tell us how you’d like to help</a></div>
<div class="grid3 photo-grid"><img class="img-full" src="/images/site/volunteer-here-to-help.jpg" alt="Volunteer in a Here to Help vest waving an American flag." loading="lazy"><img class="img-full" src="/images/site/rotary-work-party.jpg" alt="Rotary members with tools on a forest trail work party." loading="lazy"><img class="img-full" src="/images/site/volunteers-ground-design.jpg" alt="Volunteers working together on a large ground design." loading="lazy"></div>
<section class="grid3" aria-label="Ways to help"><div class="sub-card"><h2 class="h3">Share our story online</h2><p class="p">Help spread the word and inspire others.</p></div><div class="sub-card"><h2 class="h3">Introduce us to donors and businesses</h2><p class="p">Your connection can open doors.</p></div><div class="sub-card"><h2 class="h3">Host a fundraising gathering</h2><p class="p">Gather your friends, neighbors or colleagues to support our mission.</p></div><div class="sub-card"><h2 class="h3">Write a letter of support</h2><p class="p">Your words help build credibility and momentum. <a class="link" href="#letters">Suggested topics</a></p></div><div class="sub-card"><h2 class="h3">Volunteer your time</h2><p class="p">Every hour you give makes a difference.</p></div><div class="sub-card"><h2 class="h3">Help identify grants</h2><p class="p">Help us find opportunities to fund our future.</p></div><div class="sub-card"><h2 class="h3">Connect us with contractors and material providers</h2><p class="p">Your referrals help us build smart and strong. <a class="link" href="/donate/in-kind">See in-kind needs</a></p></div><div class="sub-card"><h2 class="h3">Help recruit corporate sponsors</h2><p class="p">Support our outreach to business partners.</p></div><div class="sub-card"><h2 class="h3">Join future fundraising events</h2><p class="p">Join us and help make our events a success.</p></div></section>
<section class="card">
  <h2 class="h2">Businesses: Top Off for NKU</h2>
  <p class="p">Valley Nursery’s customers round up their purchases, and the difference goes to NKU. Run your own Top Off, or sponsor at one of the nine levels.</p>
  <div class="btn-row-left"><a class="btn" href="#signup">Start a Top Off</a></div>
</section>
<section class="card" id="letters">
  <h2 class="h2">Letter of support topics</h2>
  <p class="p">If you’d like to write a support letter, helpful themes include:</p>
  <ul class="list"><li>Why youth recreation matters</li><li>Community need for fields and facilities</li><li>Family and health benefits</li><li>Economic and community impact</li><li>Keeping kids active and engaged</li><li>Importance of safe gathering spaces</li><li>Long-term community legacy</li><li>Why North Kitsap needs this project</li></ul>
</section>
<section class="card-strong" id="signup">
  <h2 class="h2">I’d like to help</h2>
  <form class="form" data-nku-form="volunteer" novalidate><label class="hp" aria-hidden="true">Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label><fieldset class="fieldset"><legend class="legend">Check all that apply</legend><label class="check"><input class="check-input" type="checkbox" name="interests" value="Share our story online"> Share our story online</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Introduce you to donors or businesses"> Introduce you to donors or businesses</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Host a gathering"> Host a gathering</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Write a letter of support"> Write a letter of support</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Volunteer"> Volunteer</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Help identify grants"> Help identify grants</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Connect you with contractors or suppliers"> Connect you with contractors or suppliers</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Recruit corporate sponsors"> Recruit corporate sponsors</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Help at fundraising events"> Help at fundraising events</label><label class="check"><input class="check-input" type="checkbox" name="interests" value="Start a Top Off at my business"> Start a Top Off at my business</label></fieldset><div class="row"><label class="field">Name *<input class="input" type="text" name="name" autocomplete="name" required></label><label class="field">Email *<input class="input" type="email" name="email" autocomplete="email" required></label><label class="field">Phone<input class="input" type="tel" name="phone" autocomplete="tel"></label></div><label class="field">Mailing address<input class="input" type="text" name="address" autocomplete="street-address"></label><label class="field">Anything you’d like us to know<textarea class="textarea" name="message" rows="3"></textarea></label><div class="btn-row-left"><button class="btn" type="submit">Send</button></div><p class="status" role="status" aria-live="polite"></p><p class="note">A team member will follow up.</p></form>
</section>
<section class="card" id="updates">
  <h2 class="h2">Stay updated</h2>
  <form class="form" data-nku-form="updates" novalidate><label class="hp" aria-hidden="true">Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label><label class="field">Email for updates *<input class="input" type="email" name="email" autocomplete="email" required></label><div class="btn-row-left"><button class="btn" type="submit">Get updates</button></div><p class="status" role="status" aria-live="polite"></p></form>
</section>
<div class="btn-row"><a class="btn btn-gold" href="/donate">Donate</a></div>
`;
---
<BaseLayout title="Get Involved" current="involved" heroTitle="Every Action Makes a Difference" heroSub="You do not need to make a financial contribution to make a meaningful impact." eyebrow="Get Involved">
  <Fragment set:html={html} />
</BaseLayout>
