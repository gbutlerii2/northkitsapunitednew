// Generated from the NKU Website design (build/pages.py). Edit the content there and regenerate.
import BaseLayout from '../../layouts/BaseLayout.astro';
const html = "\n<img class=\"img-flier\" src=\"/images/site/inkind-opportunities.jpg\" alt=\"Suggested In-Kind Donation Opportunities: construction and site work, materials, equipment, community amenities, and sponsorship and naming opportunities\">\n<div class=\"grid2\"><div class=\"photo\" role=\"img\" aria-label=\"Photo to come: Local contractors at work\"><span class=\"photo-tag\">Photo</span><span>Local contractors at work</span></div><div class=\"photo\" role=\"img\" aria-label=\"Photo to come: Materials or equipment\"><span class=\"photo-tag\">Photo</span><span>Materials or equipment</span></div></div>\n<section class=\"card\">\n  <h2 class=\"h2\">Offer an In-Kind Donation</h2>\n  <p class=\"p\">Tell us what you would like to give. Your gift will be considered in the construction planning process.</p>\n  <form class=\"form\" data-nku-form=\"inkind\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Company or donor name *<input class=\"input\" type=\"text\" name=\"company\" autocomplete=\"organization\" required></label><label class=\"field\">Contact person *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label><label class=\"field\">Contractor registration or trade license (if any)<input class=\"input\" type=\"text\" name=\"license\"></label><label class=\"field\">Proposed dates<input class=\"input\" type=\"text\" name=\"proposedDates\"></label></div><label class=\"field\">What would you like to give? (work, materials or equipment) *<textarea class=\"textarea\" name=\"offer\" rows=\"3\" required></textarea></label><div class=\"row\"><label class=\"field\">Estimated value ($)<input class=\"input\" type=\"text\" name=\"estimatedValue\" placeholder=\"$\"></label><label class=\"field\">Value based on<select class=\"input\" name=\"valueBasis\"><option>Quote</option><option>Invoice</option><option>List price</option><option>Other</option></select></label></div><div class=\"row\"><fieldset class=\"fieldset\"><legend class=\"legend\">Is the gift</legend><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"donation\" value=\"Fully donated\"> Fully donated</label><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"donation\" value=\"Partly donated\"> Partly donated (part would be paid)</label></fieldset><fieldset class=\"fieldset\"><legend class=\"legend\">Who would do the work</legend><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"workBy\" value=\"Our company crew\"> Our company crew</label><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"workBy\" value=\"Materials or equipment only\"> Materials or equipment only</label></fieldset></div><label class=\"field\">Any requests (recognition, naming, other)<textarea class=\"textarea\" name=\"requests\" rows=\"2\"></textarea></label><label class=\"field\">Who referred you to NKU? (optional)<input class=\"input\" type=\"text\" name=\"referredBy\"></label><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\">Send offer</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p><p class=\"note\">Sending an offer does not commit NKU to accept it, and a gift does not create a right to paid work.</p></form>\n</section>\n<div class=\"btn-row\"><a class=\"btn btn-ghost\" href=\"/get-involved\">Get Involved</a></div>\n";
---
<BaseLayout title="In-Kind Donations" current="inkind" heroTitle="In-Kind Donations" heroSub="Work, materials and equipment that help build the campus." eyebrow="Donate · In-Kind">
  <Fragment set:html={html} />
</BaseLayout>
