---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { FORM_KINDS, getFormEmailSettings, listSubmissions } from '../../lib/content';
import { mailFrom, mailMethod } from '../../lib/mail';

const settings = await getFormEmailSettings();
const submissions = await listSubmissions(50);
const humanizeKey = (k: string) => k.replace(/[_-]+/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());
const show = (v: unknown) => (Array.isArray(v) ? v.join(', ') : String(v ?? ''));
const method = mailMethod();
const from = mailFrom();
const donateKinds = ['zeffy', 'gift', 'pledge', 'donation-question', 'inkind'];
const otherKinds = Object.keys(FORM_KINDS).filter((k) => !donateKinds.includes(k));
const fmt = (iso?: string) => (iso ? new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Los_Angeles' }) : '');
---

<AdminLayout title="Forms & emails" active="form-emails">
  {method ? (
    <div class="mb-6 p-4 rounded-lg bg-green-50 border border-green-200 text-green-900 text-sm">
      Email sending is on ({method === 'resend' ? 'Resend' : 'SMTP'}), from <strong>{from}</strong>.
    </div>
  ) : (
    <div class="mb-6 p-4 rounded-lg bg-yellow-100 border border-yellow-300 text-yellow-900 text-sm">
      <strong>Email sending isn't set up yet.</strong> You can save the addresses now. Emails start once the email settings are added in Netlify (see docs/ADMIN.md, "Form emails").
    </div>
  )}

  <form id="form-emails" class="space-y-6">
    <div class="nku-card space-y-4">
      <h2 class="text-lg font-bold text-nku-green">NKU Tracker</h2>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" id="sendToTracker" class="w-5 h-5 mt-0.5" checked={settings.sendToTracker} />
        <span>
          <span class="font-medium">Send form submissions to the NKU Tracker</span>
          <span class="block text-sm text-nku-gray-light">When this is off, forms go only to the email addresses below, and every submission is also kept in "Recent submissions" at the bottom of this page. The Home page's campaign figures still come from the Tracker either way.</span>
        </span>
      </label>
      {!settings.sendToTracker && !method && (
        <p class="p-3 rounded bg-red-50 border border-red-200 text-red-800 text-sm"><strong>Heads up:</strong> the Tracker is off and email sending isn't set up, so submissions are only kept in "Recent submissions" below. Check there until email is working.</p>
      )}
    </div>

    <div class="nku-card space-y-4">
      <h2 class="text-lg font-bold text-nku-green">Zeffy (online giving)</h2>
      <p class="text-sm">After someone fills in the "Give online" form on the Donate page, they're sent to Zeffy to pay. Paste the links of your Zeffy donation forms here: one for card payments and one for bank transfer (EFT). If only one is filled in, it's used for both. No Zeffy password or login is needed for this, only the public links.</p>
      {!settings.zeffyCardUrl && !settings.zeffyEftUrl && (
        <p class="p-3 rounded bg-yellow-100 border border-yellow-300 text-yellow-900 text-sm">No Zeffy links yet.{settings.sendToTracker ? " Until they're added, the Tracker's own Zeffy links are used, if it has them." : " Until they're added, the \"Give online\" form tells donors online giving isn't available yet."}</p>
      )}
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1" for="zeffyCardUrl">Zeffy link for card</label>
          <input id="zeffyCardUrl" class="nku-input" value={settings.zeffyCardUrl} placeholder="https://www.zeffy.com/…" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="zeffyEftUrl">Zeffy link for bank transfer (EFT)</label>
          <input id="zeffyEftUrl" class="nku-input" value={settings.zeffyEftUrl} placeholder="https://www.zeffy.com/…" />
        </div>
      </div>
    </div>

    <div class="nku-card space-y-3">
      <h2 class="text-lg font-bold text-nku-green">Who gets the forms</h2>
      <p class="text-sm">Enter email addresses separated by semicolons, for example <code>treasurer@example.org; gerry@example.org</code>. Everyone here gets a copy of every form that doesn't have its own list below.</p>
      <label class="block text-sm font-medium" for="defaultTo">All forms</label>
      <textarea id="defaultTo" rows="2" class="nku-input" placeholder="name@example.org; other@example.org">{settings.defaultTo}</textarea>
      <p class="text-xs text-nku-gray-light">Each email's subject is the form name, a dash, then the person's name (for example "Pledge - Jane Smith"), so you can set up mail filters. Every field is on its own line, and hitting Reply goes to the person who filled in the form.</p>
    </div>

    <div class="nku-card space-y-4">
      <h2 class="text-lg font-bold text-nku-green">Different people for one form <span class="text-sm font-normal text-nku-gray-light">(optional)</span></h2>
      <p class="text-sm">Leave a box empty to use the "All forms" list. Filling one in sends that form only to those addresses.</p>
      <h3 class="font-semibold text-sm uppercase tracking-wide text-nku-brown">Donate section</h3>
      {donateKinds.map((k) => (
        <div>
          <label class="block text-sm font-medium mb-1" for={`pf-${k}`}>{FORM_KINDS[k]}</label>
          <input id={`pf-${k}`} data-kind={k} class="nku-input" value={settings.perForm[k] || ''} placeholder="Uses the All forms list" />
        </div>
      ))}
      <h3 class="font-semibold text-sm uppercase tracking-wide text-nku-brown pt-2">Other forms</h3>
      {otherKinds.map((k) => (
        <div>
          <label class="block text-sm font-medium mb-1" for={`pf-${k}`}>{FORM_KINDS[k]}</label>
          <input id={`pf-${k}`} data-kind={k} class="nku-input" value={settings.perForm[k] || ''} placeholder="Uses the All forms list" />
        </div>
      ))}
    </div>

    <div class="flex flex-wrap gap-3 items-center">
      <button type="submit" class="nku-btn">Save</button>
      {settings.updatedAt && <span class="text-xs text-nku-gray-light">Last saved {fmt(settings.updatedAt)} by {settings.updatedBy}</span>}
    </div>
  </form>

  <form id="form-emails-test" class="nku-card mt-8 space-y-3">
    <h2 class="text-lg font-bold text-nku-green">Send a test email</h2>
    <p class="text-sm">Sends a sample "Pledge" email so you can check that it arrives and set up filters.</p>
    <div class="flex gap-3">
      <input id="testTo" class="nku-input" value={Astro.locals.admin!.email} />
      <button type="submit" class="nku-btn shrink-0" disabled={!method}>Send test</button>
    </div>
  </form>
  <div class="nku-card mt-8">
    <h2 class="text-lg font-bold text-nku-green mb-3">Recent submissions</h2>
    {submissions.length === 0 ? (
      <p class="text-sm text-nku-gray-light">No forms have been sent through the website yet.</p>
    ) : (
      <div class="space-y-2">
        {submissions.map((sub) => (
          <details class="border border-gray-100 rounded-lg p-3 text-sm">
            <summary class="cursor-pointer">
              <strong>{FORM_KINDS[sub.kind] || sub.kind}</strong> - {show(sub.data.name) || show(sub.data.email) || 'No name'}
              <span class="text-nku-gray-light"> · {fmt(sub.at)} · {sub.emailedTo.length ? `emailed to ${sub.emailedTo.length}` : sub.emailError ? 'email failed' : 'not emailed'}</span>
            </summary>
            <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
              {Object.entries(sub.data).filter(([, v]) => show(v).trim()).map(([k, v]) => (
                <>
                  <dt class="font-medium text-nku-gray-light">{(sub.labels[k] || humanizeKey(k)).replace(/\s*\*\s*$/, '')}</dt>
                  <dd class="whitespace-pre-wrap break-words">{show(v)}</dd>
                </>
              ))}
            </dl>
            {sub.emailError && <p class="mt-2 text-red-700 text-xs">Email error: {sub.emailError}</p>}
          </details>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
