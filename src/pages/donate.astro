// Generated from the NKU Website design (build/pages.py). Edit the content there and regenerate.
import BaseLayout from '../layouts/BaseLayout.astro';
const html = "\n<div class=\"btn-row\">\n  <a class=\"btn\" href=\"#one-time\">One-Time Donation</a>\n  <a class=\"btn\" href=\"#pledge\">Pledge</a>\n  <a class=\"btn btn-ghost\" href=\"#tell-us\">Tell us about your gift</a>\n  <a class=\"btn btn-ghost\" href=\"#contact\">Contact Us</a>\n</div>\n<img class=\"img-flier\" src=\"/images/site/sponsorship-levels.jpg\" alt=\"Build More Than Fields, Build Opportunity: the nine sponsorship levels from Legacy Partner at $1,000,000 to Rising Star Sponsor at $1,000, with photos of youth soccer, swimming, mountain biking and the fields\">\n\n<section class=\"card\" id=\"one-time\">\n  <h2 class=\"h2\">One-Time Donation</h2>\n  <div class=\"sub-card\">\n    <h3 class=\"h3\">Check</h3>\n    <p class=\"p\">Payable to: <strong>Kingston North Kitsap Rotary Foundation</strong><br>Mail to: P.O. Box 832, Kingston, WA 98346 · Memo: NKU</p>\n    <p class=\"p\">Please also fill out <a class=\"link\" href=\"#tell-us\">Tell us about your gift</a> so we can thank you. Not using the form? Please include a note in your envelope with your name, address, phone and email.</p>\n    <p class=\"p\">You will receive a receipt.</p>\n  </div>\n  <div class=\"sub-card\">\n    <h3 class=\"h3\">Card or bank transfer (EFT): one-time, monthly or quarterly</h3>\n    <p class=\"p\">Tell us a little about your gift, then continue to Zeffy to pay. This lets us thank you and list you the way you’d like.</p>\n    <form class=\"form\" data-nku-form=\"zeffy\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Name *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label></div><label class=\"field\">Mailing address<input class=\"input\" type=\"text\" name=\"address\" autocomplete=\"street-address\"></label><div class=\"row\"><label class=\"field\">Amount ($) *<input class=\"input\" type=\"text\" name=\"amount\" placeholder=\"$\" required></label><label class=\"field\">How often<select class=\"input\" name=\"frequency\"><option>One-time</option><option>Monthly</option><option>Quarterly</option></select></label></div><div class=\"row\"><label class=\"field\">Name for recognition (as you’d like to be listed)<input class=\"input\" type=\"text\" name=\"recognitionName\"></label><label class=\"field\">In honor or memory of (optional)<input class=\"input\" type=\"text\" name=\"inHonorOf\"></label></div><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"anonymous\" value=\"yes\"> Please keep my gift anonymous</label><label class=\"field\">Why I gave (optional)<textarea class=\"textarea\" name=\"whyIGave\" rows=\"3\"></textarea></label><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\" name=\"via\" value=\"card\">Continue to Zeffy: card</button><button class=\"btn\" type=\"submit\" name=\"via\" value=\"eft\">Continue to Zeffy: bank transfer (EFT)</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p></form>\n    <p class=\"p\">Card (up to $4,999 a payment) or bank transfer (EFT, up to $20,000). Card and bank details are handled by Zeffy and its processor, Stripe, and never touch this site.</p>\n    <p class=\"p\">You will receive a receipt.</p>\n    <p class=\"p\">Zeffy is free for the Foundation. At checkout, Zeffy asks for an optional contribution to Zeffy; you can change it to $0. Every dollar of your gift goes to NKU.</p>\n  </div>\n  <div class=\"sub-card\" id=\"other-gifts\">\n    <h3 class=\"h3\">Wire transfer, stock, bonds, mutual funds, donor-advised fund (DAF), IRA or real estate</h3>\n    <p class=\"p\">Giving one of these ways takes two steps:</p>\n    <ol class=\"list\">\n      <li><strong>Call Ameriprise Financial at 360-297-4848</strong> for instructions. This number is for help with making your gift. For other questions, please use <a class=\"link\" href=\"#contact\">Contact Us</a>.</li>\n      <li><strong>Fill out <a class=\"link\" href=\"#tell-us\">Tell us about your gift</a></strong> so we can watch for your gift and thank you. These gifts often arrive without the donor’s name.</li>\n    </ol>\n    <div class=\"btn-row-left\"><a class=\"btn btn-ghost\" href=\"#tell-us\">Tell us about your gift ↓</a></div>\n    <div class=\"grid3\">\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <h4 class=\"h4\">Wire transfer</h4>\n        <p class=\"p\">You can give by wire transfer. For instructions, call Ameriprise Financial at 360-297-4848.</p>\n        <ul class=\"list\"><li>Ameriprise does not charge a fee to receive wires.</li><li>You will receive a receipt.</li><li>After you send a wire, please fill out <a class=\"link\" href=\"#tell-us\">Tell us about your gift</a> so we can thank you. Wires often arrive without the sender’s name.</li></ul>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <h4 class=\"h4\">Donor-advised fund (DAF)</h4>\n        <p class=\"p\">You can give through your donor-advised fund (DAF). For instructions, call Ameriprise Financial at 360-297-4848.</p>\n        <ul class=\"list\"><li>Your fund company sends the grant, usually within two weeks or more.</li><li>You took your tax deduction when you put money into your fund, so you’ll receive a thank-you letter that is not a tax receipt.</li><li>A DAF grant can’t pay for anything you receive in return, such as event tickets, golf or raffle tickets.</li><li>Please also fill out <a class=\"link\" href=\"#tell-us\">Tell us about your gift</a> so we know to expect it.</li></ul>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <h4 class=\"h4\">IRA qualified charitable distribution (QCD)</h4>\n        <p class=\"p\">If you are 70½ or older, you can give directly from your IRA. For instructions, call Ameriprise Financial at 360-297-4848.</p>\n        <ul class=\"list\"><li>The gift can count toward your required minimum distribution and is not taxable income to you.</li><li>Nothing can be received in return, such as event tickets or raffle tickets.</li><li>Up to $111,000 per person in 2026.</li><li>The deadline is December 31. Ask your custodian by early December, because processing takes time.</li><li>You will receive an acknowledgment.</li><li>Please also fill out <a class=\"link\" href=\"#tell-us\">Tell us about your gift</a> so we know to expect it.</li></ul>\n      </div>\n    </div>\n    <p class=\"privacy\"><strong>Make your gift to:</strong> Kingston North Kitsap Rotary Foundation · EIN 20-2960627 · P.O. Box 832, Kingston, WA 98346. Please designate it for North Kitsap United (NKU).</p>\n  </div>\n</section>\n\n<section class=\"card-strong\" id=\"tell-us\">\n  <span class=\"step-pill\">Step 2 for gifts not made through Zeffy</span>\n  <h2 class=\"h2\">Tell us about your gift</h2>\n  <p class=\"p\">Giving by check, wire, stock, bonds, mutual funds, donor-advised fund, IRA or real estate? Please let us know so we can watch for your gift and thank you.</p>\n  <form class=\"form\" data-nku-form=\"gift\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Name *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label></div><label class=\"field\">Mailing address<input class=\"input\" type=\"text\" name=\"address\" autocomplete=\"street-address\"></label><div class=\"row\"><label class=\"field\">How are you giving?<select class=\"input\" name=\"method\"><option>Check</option><option>Wire transfer</option><option>Stock</option><option>Bonds</option><option>Mutual funds</option><option>Donor-advised fund (DAF)</option><option>IRA distribution (QCD)</option><option>Real estate</option></select></label><label class=\"field\">Amount ($)<input class=\"input\" type=\"text\" name=\"amount\" placeholder=\"$\"></label><label class=\"field\">Expected date<input class=\"input\" type=\"date\" name=\"expectedDate\"></label></div><div class=\"row\"><label class=\"field\">For stock, bonds or mutual funds: name and number of shares<input class=\"input\" type=\"text\" name=\"shares\"></label><label class=\"field\">For a DAF or IRA: fund or IRA company<input class=\"input\" type=\"text\" name=\"fundCompany\"></label></div><div class=\"row\"><label class=\"field\">Name for recognition (as you’d like to be listed)<input class=\"input\" type=\"text\" name=\"recognitionName\"></label><label class=\"field\">In honor or memory of (optional)<input class=\"input\" type=\"text\" name=\"inHonorOf\"></label></div><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"anonymous\" value=\"yes\"> Please keep my gift anonymous</label><label class=\"field\">Why I gave (optional)<textarea class=\"textarea\" name=\"whyIGave\" rows=\"4\"></textarea></label><p class=\"privacy\"><strong>Your privacy.</strong> We use the information you share only to record your gift, send your receipt and thank you.</p><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\">Send</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p></form>\n</section>\n\n<section class=\"card\" id=\"pledge\">\n  <h2 class=\"h2\">Pledge</h2>\n  <form class=\"form\" data-nku-form=\"pledge\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Total amount ($) *<input class=\"input\" type=\"text\" name=\"amount\" placeholder=\"$\" required></label><label class=\"field\">Number of installments<input class=\"input\" type=\"number\" name=\"installments\"></label></div><fieldset class=\"fieldset\"><legend class=\"legend\">How often</legend><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"frequency\" value=\"Monthly\"> Monthly, beginning: <input class=\"inline-input\" type=\"date\" name=\"begin_monthly\" aria-label=\"Monthly start date\"></label><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"frequency\" value=\"Quarterly\"> Quarterly, beginning: <input class=\"inline-input\" type=\"date\" name=\"begin_quarterly\" aria-label=\"Quarterly start date\"></label><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"frequency\" value=\"Semi-annually\"> Semi-annually, beginning: <input class=\"inline-input\" type=\"date\" name=\"begin_semiannually\" aria-label=\"Semi-annually start date\"></label><label class=\"check\"><input class=\"check-input\" type=\"radio\" name=\"frequency\" value=\"Annually\"> Annually, beginning: <input class=\"inline-input\" type=\"date\" name=\"begin_annually\" aria-label=\"Annually start date\"></label></fieldset><div class=\"row\"><label class=\"field\">Name *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label></div><label class=\"field\">Mailing address<input class=\"input\" type=\"text\" name=\"address\" autocomplete=\"street-address\"></label><fieldset class=\"fieldset\"><legend class=\"legend\">How do you plan to pay? (check any)</legend><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Card or bank transfer (EFT) through Zeffy, monthly or quarterly\"> Card or bank transfer (EFT) through Zeffy, monthly or quarterly</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Check\"> Check</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Wire transfer\"> Wire transfer</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Stock, bonds or mutual funds\"> Stock, bonds or mutual funds</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Donor-advised fund\"> Donor-advised fund</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"IRA (QCD)\"> IRA (QCD)</label><label class=\"check\"><input class=\"check-input\" type=\"checkbox\" name=\"payment\" value=\"Real estate\"> Real estate</label></fieldset><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\">Send pledge</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p></form>\n</section>\n\n<section class=\"card\" id=\"contact\">\n  <h2 class=\"h2\">Contact Us</h2>\n  <p class=\"p\">For questions about a donation or pledge, send us a message:</p>\n  <form class=\"form\" data-nku-form=\"donation-question\" novalidate><label class=\"hp\" aria-hidden=\"true\">Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><div class=\"row\"><label class=\"field\">Name *<input class=\"input\" type=\"text\" name=\"name\" autocomplete=\"name\" required></label><label class=\"field\">Email *<input class=\"input\" type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label class=\"field\">Phone<input class=\"input\" type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label></div><label class=\"field\">How can we help? *<textarea class=\"textarea\" name=\"message\" rows=\"3\" required></textarea></label><div class=\"btn-row-left\"><button class=\"btn\" type=\"submit\">Send</button></div><p class=\"status\" role=\"status\" aria-live=\"polite\"></p></form>\n</section>\n<div class=\"btn-row\"><a class=\"btn btn-ghost\" href=\"/get-involved\">Get Involved</a></div>\n";
---
<BaseLayout title="Donate" current="cash" heroTitle="Donate" heroSub="Build more than fields. Build opportunity." eyebrow="Donate · Cash">
  <Fragment set:html={html} />
</BaseLayout>
