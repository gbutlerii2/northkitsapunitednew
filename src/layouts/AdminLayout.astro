---
import '../styles/global.css';

interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;
const admin = Astro.locals.admin;

const nav = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin-panel' },
  { id: 'pages', label: 'Edit pages', href: '/admin-panel/pages' },
  { id: 'news', label: 'News', href: '/admin-panel/news' },
  { id: 'media', label: 'Images', href: '/admin-panel/media' },
  { id: 'users', label: 'Users & password', href: '/admin-panel/users' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/nku_icon.svg" />
    <title>{title} | NKU Admin</title>
    <link rel="stylesheet" href="/admin-assets/admin.css" />
  </head>
  <body class="min-h-screen bg-nku-cream text-nku-gray">
    {admin ? (
      <div class="min-h-screen flex flex-col md:flex-row">
        <aside class="bg-nku-green-dark text-green-100 md:w-60 shrink-0 md:min-h-screen">
          <div class="p-4 flex items-center gap-2 border-b border-white/10">
            <img src="/images/logos/nku-logo.png" alt="" class="h-8 w-auto" />
            <span class="font-bold text-white">NKU Admin</span>
          </div>
          <nav class="p-2 flex md:flex-col gap-1 overflow-x-auto" aria-label="Admin navigation">
            {nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'px-3 py-2 rounded-md text-sm whitespace-nowrap',
                  active === n.id ? 'bg-nku-green text-white font-semibold' : 'hover:bg-nku-green hover:text-white',
                ]}
              >
                {n.label}
              </a>
            ))}
            <a href="/" class="px-3 py-2 rounded-md text-sm whitespace-nowrap hover:bg-nku-green hover:text-white">View site &nearr;</a>
          </nav>
          <div class="p-4 text-xs text-green-200 border-t border-white/10 hidden md:block">
            Signed in as<br /><span class="text-white break-all">{admin.email}</span>
            <button id="nku-logout" class="mt-3 block w-full text-left text-green-100 underline hover:text-white">Log out</button>
          </div>
        </aside>
        <main class="flex-1 p-4 sm:p-8 max-w-5xl">
          <h1 class="text-2xl font-bold text-nku-green mb-6">{title}</h1>
          <slot />
          <button id="nku-logout-m" class="md:hidden mt-10 text-sm underline">Log out</button>
        </main>
      </div>
    ) : (
      <slot />
    )}
    <div id="nku-toast" class="nku-toast" role="status" aria-live="polite"></div>
    <script is:inline src="/admin-assets/upload.js"></script>
    <script is:inline src="/admin-assets/admin.js"></script>
  </body>
</html>
