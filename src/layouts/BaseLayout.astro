---
import '../styles/global.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import EditableRegion from '../components/EditableRegion.astro';
import { getFormEmailSettings } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: string;
  heroTitle?: string;
  heroSub?: string;
  eyebrow?: string;
  /**
   * 'page' (default): the title band and page body can be edited from /admin-panel.
   * 'regions': only the title band and <EditableRegion> blocks inside the page (for pages with live lists, like News).
   * 'none': not editable in place.
   */
  editable?: 'page' | 'regions' | 'none';
}

const {
  title,
  description = 'North Kitsap United is a YMCA-centered sports, recreation, and well-being campus at Bond Road and Stottlemeyer Road in North Kitsap County.',
  ogImage = '/images/site/site-plan.jpg',
  current = '',
  heroTitle = title,
  heroSub = '',
  eyebrow = '',
  editable = 'page',
} = Astro.props;
const admin = Astro.locals.admin;
// Admin > Forms can switch off sending form submissions to the NKU Tracker.
let formSettings = { sendToTracker: true, zeffyCardUrl: '', zeffyEftUrl: '' };
try {
  formSettings = await getFormEmailSettings();
} catch {
  /* storage unreachable: keep defaults */
}
const sendTracker = formSettings.sendToTracker;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// " - New" marks this build in browser tabs while the old site is still up; remove it at launch.
const fullTitle = title === 'Home' ? 'North Kitsap United - New' : `${title} | North Kitsap United - New`;
// The NKU Tracker serves the campaign figures and receives the website's forms.
const trackerApi = import.meta.env.PUBLIC_TRACKER_API || 'https://nku-tracker.com';
---

<!doctype html>
<html lang="en" data-tracker-api={trackerApi} data-send-tracker={sendTracker ? "1" : "0"} data-zeffy-card={formSettings.zeffyCardUrl || undefined} data-zeffy-eft={formSettings.zeffyEftUrl || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/nku_icon.svg" />
    <link rel="icon" type="image/x-icon" href="/nku_icon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
  </head>
  <body class="page">
    <SiteHeader current={current} />
    {editable === 'none' ? (
      <section class="hero">
        <div class="hero-inner">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1 class="hero-title">{heroTitle}</h1>
          {heroSub && <p class="hero-sub">{heroSub}</p>}
        </div>
      </section>
    ) : (
      <EditableRegion id="hero">
        <section class="hero">
          <div class="hero-inner">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h1 class="hero-title">{heroTitle}</h1>
            {heroSub && <p class="hero-sub">{heroSub}</p>}
          </div>
        </section>
      </EditableRegion>
    )}
    <main class="main">
      {editable === 'page' ? <EditableRegion id="main"><slot /></EditableRegion> : <slot />}
    </main>
    <Footer />
    <script is:inline src="/js/nku-site.js" defer></script>
    {admin && (
      <>
        <link rel="stylesheet" href="/admin-assets/editor.css" />
        <script is:inline type="application/json" id="nku-admin-data" set:html={JSON.stringify({ email: admin.email, editable }).replace(/</g, '\\u003c')} />
        <script is:inline src="/admin-assets/upload.js"></script>
        <script is:inline src="/admin-assets/editor.js"></script>
      </>
    )}
  </body>
</html>
