---
import '../styles/global.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: string;
  heroTitle?: string;
  heroSub?: string;
  eyebrow?: string;
}

const {
  title,
  description = 'North Kitsap United is a YMCA-centered sports, recreation, and well-being campus at Bond Road and Stottlemeyer Road in North Kitsap County.',
  ogImage = '/images/site/site-plan.jpg',
  current = '',
  heroTitle = title,
  heroSub = '',
  eyebrow = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// " - New" marks this build in browser tabs while the old site is still up; remove it at launch.
const fullTitle = title === 'Home' ? 'North Kitsap United - New' : `${title} | North Kitsap United - New`;
// The NKU Tracker serves the campaign figures and receives the website's forms.
const trackerApi = import.meta.env.PUBLIC_TRACKER_API || 'https://nku-tracker.com';
---

<!doctype html>
<html lang="en" data-tracker-api={trackerApi}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/nku_icon.svg" />
    <link rel="icon" type="image/x-icon" href="/nku_icon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
  </head>
  <body class="page">
    <SiteHeader current={current} />
    <section class="hero">
      <div class="hero-inner">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="hero-title">{heroTitle}</h1>
        {heroSub && <p class="hero-sub">{heroSub}</p>}
      </div>
    </section>
    <main class="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/js/nku-site.js" defer></script>
  </body>
</html>
