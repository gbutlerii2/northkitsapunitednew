---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DocumentCard from '../../components/DocumentCard.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const reports = [
  {
    title: 'NK Recreation Facility Feasibility Study',
    description: 'Prepared by BERK',
    date: 'December 2024',
    href: '/media/north-kitsap-rec-facility-study.pdf',
  },
  {
    title: 'Critical Areas Report',
    date: 'November 2024',
    href: '/media/critical-areas-report.pdf',
  },
  {
    title: 'Wet Weather Wetland Study',
    date: 'April 2, 2024',
    href: '/media/wet-weather-wetland-study.pdf',
  },
  {
    title: 'Wet Weather Geotechnical Report',
    date: 'February 29, 2024',
    href: '/media/wet-weather-geotechnical-report.pdf',
  },
  {
    title: 'Feasibility Report - Part 1',
    date: 'December 8, 2023',
    href: '/media/feasibility-report-part-1.pdf',
  },
  {
    title: 'Feasibility Report - Part 2',
    date: 'December 8, 2023',
    href: '/media/feasibility-report-part-2.pdf',
  },
  {
    title: 'NK/Poulsbo Market Study Refresh',
    date: 'June 2023',
    href: '/media/nk-poulsbo-market-study.pdf',
  },
];

const whitePaper = {
  title: 'Compliance with Kitsap County Land-use Regulations and The Washington State Growth Management Act',
  description: 'NKU White Paper',
  href: '/media/nku-whitepaper.pdf',
};
---

<BaseLayout title="Materials" description="Download reports, studies, and documents related to the North Kitsap United project.">
  <Hero title="Materials" subtitle="Reports, studies, and project documents" />

  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-nku-green mb-6">NKU Reports</h2>
      <div class="space-y-4 mb-12">
        {reports.map((report) => (
          <DocumentCard
            title={report.title}
            description={report.description}
            date={report.date}
            href={report.href}
          />
        ))}
      </div>

      <h2 class="text-2xl font-bold text-nku-green mb-6">NKU White Paper</h2>
      <DocumentCard
        title={whitePaper.title}
        description={whitePaper.description}
        href={whitePaper.href}
      />
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
